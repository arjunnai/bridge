#!/usr/bin/env bash
# bridge-ps — list active bridge runs across open PRs.
set -eu

_BRIDGE_BIN_DIR=$(cd "$(dirname "$0")" && pwd)
if [ -L "$0" ]; then
  _real=$(readlink "$0")
  case "$_real" in
    /*) ;;
    *) _real="$_BRIDGE_BIN_DIR/$_real" ;;
  esac
  _BRIDGE_BIN_DIR=$(cd "$(dirname "$_real")" && pwd)
fi
_BRIDGE_LIB_DIR="$_BRIDGE_BIN_DIR/../lib"
# shellcheck source=lib/bridge-common.sh disable=SC1091
. "$_BRIDGE_LIB_DIR/bridge-common.sh"

usage() {
  cat <<EOF
usage: bridge ps [options]

Lists active bridge runs across open GitHub PRs by scanning PR bodies and
issue comments for BRIDGE_RUN_ID / BRIDGE_STATUS markers.

Options:
  --repo OWNER/REPO   repo override
  --all               include closed PRs (slower)
  --json              output as JSON array
  --watch             poll continuously; print lines when status changes
  --poll SECONDS      poll interval for --watch (default: 15)
  -h, --help          show this help
EOF
}

repo=""
include_closed=0
json_out=0
watch_mode=0
poll_interval=15

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --repo)    repo="${2:?--repo requires value}"; shift 2 ;;
    --all)     include_closed=1; shift ;;
    --json)    json_out=1; shift ;;
    --watch)   watch_mode=1; shift ;;
    --poll)    poll_interval="${2:?--poll requires value}"; shift 2 ;;
    --) shift; break ;;
    -*) die "unknown flag: $1 (try --help)" ;;
    *) die "unexpected argument: $1" ;;
  esac
done

bridge_load
require_cmd gh
require_cmd jq

[ -n "$repo" ] || repo=$(bridge_resolve_repo) || die "could not resolve GitHub repo (use --repo or set BRIDGE_REPO)"

if [ "$include_closed" -eq 1 ]; then
  pr_state="all"
else
  pr_state="open"
fi

# shellcheck disable=SC2016
_marker_extract_jq='
def marker_values($name):
  ((. // "") | split("\n") | map(sub("\r$"; "")))
  | map(select(test("^[[:space:]]*" + $name + ":[[:space:]]+[^[:space:]]+[[:space:]]*$")))
  | map(sub("^[[:space:]]*" + $name + ":[[:space:]]+"; "") | sub("[[:space:]]+$"; ""));
'

# For each PR, fetch body + issue comments and extract run/status markers.
# Outputs: pr\trun_id\tstatus\tupdated_at\ttitle
_scan_pr() {
  local pr_num="$1" pr_title="$2" pr_updated="$3"

  local body
  body=$(gh api "repos/$repo/pulls/$pr_num" --jq '.body // ""' 2>/dev/null || printf "")

  local comments
  comments=$(gh api "repos/$repo/issues/$pr_num/comments" --paginate 2>/dev/null || printf "[]")

  # Combine body + comment bodies into one stream and extract markers.
  local combined
  combined=$(printf '%s\n' "$body"; printf "%s" "$comments" | jq -r '.[].body // "" | .')

  # Find the last BRIDGE_RUN_ID and BRIDGE_STATUS in combined text.
  local run_ids statuses last_status
  run_ids=$(printf "%s\n" "$combined" | awk '
    /^[[:space:]]*BRIDGE_RUN_ID:[[:space:]]+[^[:space:]]/ {
      v = $0
      sub(/^[[:space:]]*BRIDGE_RUN_ID:[[:space:]]+/, "", v)
      sub(/[[:space:]]+$/, "", v)
      print v
    }
  ' | sort -u)

  [ -n "$run_ids" ] || return 0

  statuses=$(printf "%s\n" "$combined" | awk '
    /^[[:space:]]*BRIDGE_STATUS:[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*$/ {
      v = $0
      sub(/^[[:space:]]*BRIDGE_STATUS:[[:space:]]+/, "", v)
      sub(/[[:space:]]+$/, "", v)
      print v
    }
  ')
  last_status=$(printf "%s\n" "$statuses" | tail -1)
  [ -n "$last_status" ] || last_status="unknown"

  # Each unique run_id in this PR gets a row.
  while IFS= read -r rid; do
    [ -n "$rid" ] || continue
    printf "%s\t%s\t%s\t%s\t%s\n" "$pr_num" "$rid" "$last_status" "$pr_updated" "$pr_title"
  done <<EOF
$run_ids
EOF
}

_rel_time() {
  local iso="$1"
  local epoch now diff
  epoch=$(bridge_iso_to_epoch "$iso" 2>/dev/null || echo 0)
  now=$(date -u +%s)
  diff=$(( now - epoch ))
  if   [ "$diff" -lt 60 ];    then printf "%ds ago" "$diff"
  elif [ "$diff" -lt 3600 ];  then printf "%dm ago" "$(( diff / 60 ))"
  elif [ "$diff" -lt 86400 ]; then printf "%dh ago" "$(( diff / 3600 ))"
  else                              printf "%dd ago" "$(( diff / 86400 ))"
  fi
}

_fetch_rows() {
  local _prs _pr_count _pr_numbers _rows _pr_num _pr_title _pr_updated _row
  _prs=$(gh pr list --repo "$repo" --state "$pr_state" --limit 100 --json number,title,headRefName,updatedAt 2>/dev/null || printf "[]")
  _pr_count=$(printf "%s" "$_prs" | jq 'length')
  [ "$_pr_count" -gt 0 ] || { printf ""; return 0; }
  _pr_numbers=$(printf "%s" "$_prs" | jq -r '.[] | [.number, .title, .updatedAt] | @tsv')
  _rows=""
  while IFS=$(printf '\t') read -r _pr_num _pr_title _pr_updated; do
    [ -n "$_pr_num" ] || continue
    _row=$(_scan_pr "$_pr_num" "$_pr_title" "$_pr_updated")
    [ -n "$_row" ] || continue
    _rows="${_rows:+$_rows
}$_row"
  done <<PREOF
$_pr_numbers
PREOF
  printf "%s" "$_rows"
}

_print_rows() {
  local _rows="$1"
  if [ "$json_out" -eq 1 ]; then
    printf "%s\n" "$_rows" | awk -F'\t' '
      BEGIN { printf "[" }
      NR > 1 { printf "," }
      {
        title = $5; gsub(/"/, "\\\"", title)
        printf "{\"pr\":%s,\"run_id\":\"%s\",\"status\":\"%s\",\"updated_at\":\"%s\",\"title\":\"%s\"}", $1, $2, $3, $4, title
      }
      END { printf "]\n" }
    '
    return
  fi
  printf "%-6s %-32s %-28s %-7s\n" "PR" "RUN_ID" "STATUS" "UPDATED"
  printf "%-6s %-32s %-28s %-7s\n" "------" "--------------------------------" "----------------------------" "-------"
  while IFS=$(printf '\t') read -r _pr_num _rid _status _pr_updated _pr_title; do
    [ -n "$_pr_num" ] || continue
    _rel=$(_rel_time "$_pr_updated")
    printf "%-6s %-32s %-28s %-7s\n" "#$_pr_num" "$_rid" "$_status" "$_rel"
  done <<ROWEOF
$_rows
ROWEOF
}

if [ "$watch_mode" -eq 0 ]; then
  rows=$(_fetch_rows)
  if [ -z "$rows" ]; then
    if [ "$json_out" -eq 1 ]; then printf "[]\n"; else log_info "no bridge runs found in $repo"; fi
    exit 0
  fi
  _print_rows "$rows"
  exit 0
fi

# --watch mode: poll and print lines when status changes.
log_info "watching $repo every ${poll_interval}s (Ctrl-C to stop)"
prev_state=""   # key=run_id value=status

while :; do
  rows=$(_fetch_rows)
  # Build current state snapshot: run_id=status lines.
  current_state=""
  while IFS=$(printf '\t') read -r _pr _rid _status _updated _title; do
    [ -n "$_rid" ] || continue
    current_state="${current_state:+$current_state
}${_rid}=${_status}"
  done <<WEOF
${rows:-}
WEOF

  # Print header once on first pass, then only changed/new rows.
  if [ -z "$prev_state" ]; then
    if [ -n "$rows" ]; then
      _print_rows "$rows"
    else
      log_info "no bridge runs found yet"
    fi
  else
    # Detect new or changed run_ids.
    changed_rows=""
    while IFS=$(printf '\t') read -r _pr _rid _status _updated _title; do
      [ -n "$_rid" ] || continue
      # Look for this run_id in prev_state.
      prev_status=$(printf "%s\n" "$prev_state" | awk -F= -v rid="$_rid" '$1 == rid { print $2; exit }')
      if [ "$prev_status" != "$_status" ]; then
        changed_rows="${changed_rows:+$changed_rows
}${_pr}	${_rid}	${_status}	${_updated}	${_title}"
      fi
    done <<WEOF2
${rows:-}
WEOF2
    if [ -n "$changed_rows" ]; then
      now_iso=$(bridge_now_iso)
      printf "\n[%s]\n" "$now_iso"
      _print_rows "$changed_rows"
    fi
  fi

  prev_state="$current_state"
  sleep "$poll_interval"
done
