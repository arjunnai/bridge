#!/usr/bin/env bash
# bridge-phase — human-friendly phase orchestration wrappers.
set -eu

_BRIDGE_BIN_DIR=$(cd "$(dirname "$0")" && pwd)
if [ -L "$0" ]; then
  _real=$(readlink "$0")
  case "$_real" in
    /*) ;;
    *) _real="$_BRIDGE_BIN_DIR/$_real" ;;
  esac
  _BRIDGE_BIN_DIR=$(cd "$(dirname "$_real")" && pwd)
fi
_BRIDGE_LIB_DIR="$_BRIDGE_BIN_DIR/../lib"
# shellcheck source=lib/bridge-common.sh disable=SC1091
. "$_BRIDGE_LIB_DIR/bridge-common.sh"

_usage_common_opts() {
  cat <<EOF
Common options:
  --repo OWNER/REPO     repo override
  --pr NUMBER           PR number when one exists
  --run-id ID           bridge run ID
  --agent AGENT         override target agent for this step
  --source-agent AGENT  source agent label (default: codex)
  --task TEXT           task text (can also be positional)
  --repo, --pr, --run-id, --agent accept env overrides too
EOF
}

usage() {
  cat <<EOF
usage: bridge phase <command> [options] [task]

Commands:
  run               Full lifecycle: plan -> plan-review -> context -> implement -> review -> fixes.
  resume            Adopt or continue an existing PR from its latest bridge marker.
  plan              Nudge orchestrator to write the phase plan.
  plan-review       Nudge reviewer to adversarially review the plan.
  plan-fix          Nudge orchestrator to revise plan after review feedback.
  review-plan-file  Plan-review/fix loop on an existing plan file; stops at plan_approved.
  plan-edit         Open the phase plan file in \$EDITOR.
  implement         Nudge implementer to execute the phase plan.
  review            Nudge reviewer for adversarial code review.
  context           Nudge context_maintainer to update durable docs.
  watch             Wait for a phase marker: plan, implementation, or complete.

Run 'bridge phase <command> --help' for per-command options.

Examples:
  bridge phase run --task "Phase 0: inspect live DB prerequisites"
  bridge phase resume --pr 12
  bridge phase resume --pr 12 --review-plan
  bridge phase review-plan-file --pr 12 --plan-file docs/architecture/foo.md
  bridge phase watch --state complete --run-id bridge-... --pr 12
EOF
}

usage_run() {
  cat <<EOF
usage: bridge phase run --task TEXT [options]

Drive the full lifecycle: plan -> plan-review loop -> context sidecar ->
implement -> code review -> fix cycles, ending at BRIDGE_STATUS: approved +
BRIDGE_PHASE_STATUS: completed.

Required:
  --task TEXT           what to build

Options:
  --repo OWNER/REPO     repo override
  --pr NUMBER           attach to an existing PR instead of opening a new one
  --max-cycles N        implementation review/fix cycles (default: 5)
  --max-plan-cycles N   plan-review cycles before bailing (default: 20)
  --merge               merge the PR after completion (default: off)
  --no-merge            do not merge (default)
  --merge-method NAME   merge|squash|rebase (default: squash)
  --source-agent AGENT  source agent label (default: codex)
EOF
}

usage_resume() {
  cat <<EOF
usage: bridge phase resume --pr NUMBER [options]

Adopt or continue an existing PR from its latest bridge marker.
Detects current BRIDGE_STATUS and picks the next action automatically.

Resumable statuses: plan_ready, plan_approved, plan_changes_requested,
  implementation_ready, fixes_pushed, changes_requested, approved+completed.

Required:
  --pr NUMBER           PR number to resume

Options:
  --task TEXT           required if PR has no BRIDGE_RUN_ID yet (adoption)
  --run-id ID           required if PR has multiple BRIDGE_RUN_ID markers
  --implementer AGENT   override implementer agent
  --reviewer AGENT      override reviewer agent
  --review-plan         run the plan-review gate before implementation
  --merge               merge after approved + completed (opt-in)
  --no-merge            do not merge (default)
  --merge-method NAME   merge|squash|rebase (default: squash)
  --dry-run             print detected state and next action without acting
  --max-cycles N        implementation review/fix cycles (default: 5)
  --max-plan-cycles N   plan-review cycles before bailing (default: 20)
  --repo OWNER/REPO     repo override
  --source-agent AGENT  source agent label (default: codex)
EOF
}

usage_plan() {
  cat <<EOF
usage: bridge phase plan --task TEXT [options]

Nudge the orchestrator to write the phase plan to BRIDGE_PHASE_PLAN.md and
post BRIDGE_STATUS: plan_ready.

Required:
  --task TEXT           what to plan

Options:
  --repo OWNER/REPO
  --pr NUMBER           attach to an existing PR
  --run-id ID           use an explicit run ID
  --agent AGENT         override orchestrator agent
  --source-agent AGENT  (default: codex)
EOF
}

usage_plan_review() {
  cat <<EOF
usage: bridge phase plan-review --pr NUMBER --run-id ID [options]

Nudge the reviewer to adversarially review the phase plan. Posts
BRIDGE_STATUS: plan_approved or plan_changes_requested.

Required:
  --pr NUMBER
  --run-id ID

Options:
  --plan-file PATH      override plan file (default: BRIDGE_PHASE_PLAN.md)
  --agent AGENT         override reviewer agent
  --repo OWNER/REPO
  --source-agent AGENT
EOF
}

usage_plan_fix() {
  cat <<EOF
usage: bridge phase plan-fix --pr NUMBER --run-id ID [options]

Nudge the orchestrator to revise the plan file after plan_changes_requested.
Posts BRIDGE_STATUS: plan_ready when done.

Required:
  --pr NUMBER
  --run-id ID

Options:
  --plan-file PATH      override plan file (default: BRIDGE_PHASE_PLAN.md)
  --agent AGENT         override fixer agent
  --repo OWNER/REPO
  --source-agent AGENT
EOF
}

usage_review_plan_file() {
  cat <<EOF
usage: bridge phase review-plan-file --pr NUMBER --plan-file PATH [options]

Run the plan-review/fix loop on an existing plan file on disk. Stops at
BRIDGE_STATUS: plan_approved without triggering implementation or merging.

To implement after plan_approved:
  bridge phase resume --pr NUMBER

Required:
  --pr NUMBER
  --plan-file PATH      path to plan file on disk

Options:
  --run-id ID           use explicit run ID; auto-detected or generated if absent
  --reviewer AGENT      override reviewer agent
  --fixer AGENT         override plan-fix agent
  --max-plan-cycles N   plan-review cycles before bailing (default: 20)
  --dry-run             print config without acting
  --repo OWNER/REPO
  --source-agent AGENT
EOF
}

usage_implement() {
  cat <<EOF
usage: bridge phase implement --run-id ID [options]

Nudge the implementer to execute the phase plan and post
BRIDGE_STATUS: implementation_ready.

Required:
  --run-id ID

Options:
  --pr NUMBER
  --task TEXT           override default task description
  --agent AGENT         override implementer agent
  --repo OWNER/REPO
  --source-agent AGENT
EOF
}

usage_review() {
  cat <<EOF
usage: bridge phase review --run-id ID --pr NUMBER [options]

Nudge the reviewer for adversarial code review. Posts BRIDGE_STATUS: approved
or changes_requested.

Required:
  --run-id ID
  --pr NUMBER

Options:
  --task TEXT           override default task description
  --agent AGENT         override reviewer agent
  --repo OWNER/REPO
  --source-agent AGENT
EOF
}

usage_context() {
  cat <<EOF
usage: bridge phase context --run-id ID --pr NUMBER [options]

Nudge the context_maintainer to update durable agent docs. Posts
BRIDGE_STATUS: context_updated or context_noop.

Required:
  --run-id ID
  --pr NUMBER
  (orchestration.context_maintainer must be set in config.toml)

Options:
  --task TEXT
  --agent AGENT
  --repo OWNER/REPO
  --source-agent AGENT
EOF
}

usage_watch() {
  cat <<EOF
usage: bridge phase watch --pr NUMBER [options]

Wait for a phase marker on a PR.

Required:
  --pr NUMBER

Options:
  --state plan|implementation|approved|complete  (default: complete)
  --run-id ID
  --timeout SECONDS    (default: 1200)
  --poll SECONDS       (default: 10)
  --repo OWNER/REPO
EOF
}

usage_plan_edit() {
  cat <<EOF
usage: bridge phase plan-edit [--pr NUMBER] [--plan-file PATH]

Open the phase plan file in \$EDITOR. Useful after plan_changes_requested to
hand-edit before re-submitting to the plan-review loop.

Options:
  --plan-file PATH   explicit path to plan file (default: config or BRIDGE_PHASE_PLAN.md)
  --pr NUMBER        if given, print the plan file path from this PR's adoption comment
  --repo OWNER/REPO
EOF
}

cmd="${1:-}"
case "$cmd" in
  -h|--help|'') usage; exit 0 ;;
  run)                shift; case "${1:-}" in -h|--help) usage_run;              exit 0 ;; esac ;;
  resume)             shift; case "${1:-}" in -h|--help) usage_resume;           exit 0 ;; esac ;;
  plan)               shift; case "${1:-}" in -h|--help) usage_plan;             exit 0 ;; esac ;;
  plan-review)        shift; case "${1:-}" in -h|--help) usage_plan_review;      exit 0 ;; esac ;;
  plan-fix)           shift; case "${1:-}" in -h|--help) usage_plan_fix;         exit 0 ;; esac ;;
  review-plan-file)   shift; case "${1:-}" in -h|--help) usage_review_plan_file; exit 0 ;; esac ;;
  plan-edit)          shift; case "${1:-}" in -h|--help) usage_plan_edit;        exit 0 ;; esac ;;
  implement)          shift; case "${1:-}" in -h|--help) usage_implement;        exit 0 ;; esac ;;
  review)             shift; case "${1:-}" in -h|--help) usage_review;           exit 0 ;; esac ;;
  context)            shift; case "${1:-}" in -h|--help) usage_context;          exit 0 ;; esac ;;
  watch)              shift; case "${1:-}" in -h|--help) usage_watch;            exit 0 ;; esac ;;
  *) die "unknown phase command: $cmd (try: bridge phase --help)" ;;
esac

bridge_load

repo="${BRIDGE_GITHUB_REPO:-}"
pr=""
run_id=""
agent=""
implementer_agent=""
reviewer_agent=""
source_agent="codex"
task=""
state=""
timeout=""
poll=""
max_cycles=5
max_plan_cycles=20
review_plan=0
auto_merge=1
merge_requested=0
dry_run=0
merge_method="squash"
plan_file=""
fixer_agent=""

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)         repo="${2:?--repo requires value}"; shift 2 ;;
    --pr)           pr="${2:?--pr requires value}"; shift 2 ;;
    --run-id)       run_id="${2:?--run-id requires value}"; shift 2 ;;
    --agent)        agent="${2:?--agent requires value}"; shift 2 ;;
    --implementer)  implementer_agent="${2:?--implementer requires value}"; shift 2 ;;
    --reviewer)     reviewer_agent="${2:?--reviewer requires value}"; shift 2 ;;
    --source-agent) source_agent="${2:?--source-agent requires value}"; shift 2 ;;
    --task)         task="${2:?--task requires value}"; shift 2 ;;
    --state)        state="${2:?--state requires value}"; shift 2 ;;
    --timeout)      timeout="${2:?--timeout requires value}"; shift 2 ;;
    --poll)         poll="${2:?--poll requires value}"; shift 2 ;;
    --max-cycles)   max_cycles="${2:?--max-cycles requires value}"; shift 2 ;;
    --max-plan-cycles) max_plan_cycles="${2:?--max-plan-cycles requires value}"; shift 2 ;;
    --review-plan)  review_plan=1; shift ;;
    --plan-file)    plan_file="${2:?--plan-file requires value}"; shift 2 ;;
    --fixer)        fixer_agent="${2:?--fixer requires value}"; shift 2 ;;
    --dry-run)      dry_run=1; shift ;;
    --merge)        auto_merge=1; merge_requested=1; shift ;;
    --no-merge)     auto_merge=0; shift ;;
    --merge-method) merge_method="${2:?--merge-method requires value}"; shift 2 ;;
    -h|--help)      usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown flag: $1 (try: bridge phase --help)" ;;
    *)
      if [ -z "$task" ]; then task="$1"; else task="$task $1"; fi
      shift
      ;;
  esac
done

template_dir="$_BRIDGE_BIN_DIR/../templates"
phase_file=$(bridge_phase_plan_file)

[ -n "$repo" ] || repo=$(bridge_resolve_repo) || repo=""
[ -n "$poll" ] || poll="${BRIDGE_WATCH_POLL:-10}"
[ -n "$timeout" ] || timeout="${BRIDGE_WATCH_TIMEOUT:-1200}"
case "$merge_method" in
  merge|squash|rebase) ;;
  *) die "--merge-method must be merge, squash, or rebase" ;;
esac

# shellcheck disable=SC2016  # jq program — $rid/$status are jq args, not shell vars
_line_marker_jq='
def marker($name; $want):
  ((. // "") | split("\n") | map(sub("\r$"; "")))
  | any(. as $l |
      ($l | test("^[[:space:]]*" + $name + ":[[:space:]]+[^[:space:]]+[[:space:]]*$"))
      and (($l
        | sub("^[[:space:]]*" + $name + ":[[:space:]]+"; "")
        | sub("[[:space:]]+$"; "")) == $want)
    );
def has_run($rid): marker("BRIDGE_RUN_ID"; $rid);
def has_status($status): marker("BRIDGE_STATUS"; $status);
def has_phase($pstatus): marker("BRIDGE_PHASE_STATUS"; $pstatus);
'

# shellcheck disable=SC2016  # jq program — single-quoted by design.
_marker_extract_jq='
def marker_values($name):
  ((. // "") | split("\n") | map(sub("\r$"; "")))
  | map(select(test("^[[:space:]]*" + $name + ":[[:space:]]+[^[:space:]]+[[:space:]]*$")))
  | map(sub("^[[:space:]]*" + $name + ":[[:space:]]+"; "") | sub("[[:space:]]+$"; ""));
def run_ids: marker_values("BRIDGE_RUN_ID");
def statuses: marker_values("BRIDGE_STATUS");
def phase_statuses: marker_values("BRIDGE_PHASE_STATUS");
'

_body_has() {
  body=$1
  want_status=$2
  want_phase=$3
  printf "%s" "$body" | jq -e -R -s \
    --arg rid "$run_id" --arg status "$want_status" --arg pstatus "$want_phase" \
    "$_line_marker_jq"'
      has_run($rid)
      and has_status($status)
      and (($pstatus == "") or has_phase($pstatus))
    ' >/dev/null
}

_pr_has_marker() {
  # _pr_has_marker <pr> <status> [phase-status]
  check_pr=$1
  want_status=$2
  want_phase="${3:-}"
  api_repo="$repo"
  body=$(gh api "repos/$api_repo/pulls/$check_pr" --jq '.body // ""' 2>/dev/null || printf "")
  if _body_has "$body" "$want_status" "$want_phase"; then return 0; fi

  comments=$(gh api "repos/$api_repo/issues/$check_pr/comments" --paginate 2>/dev/null || printf "[]")
  if printf "%s" "$comments" | jq -e \
    --arg rid "$run_id" --arg status "$want_status" --arg pstatus "$want_phase" \
    "$_line_marker_jq"'
      (if type == "array" then . else [] end)
      | any((.body // "") as $b |
          ($b | has_run($rid))
          and ($b | has_status($status))
          and (($pstatus == "") or ($b | has_phase($pstatus)))
        )
    ' >/dev/null; then return 0; fi

  reviews=$(gh api "repos/$api_repo/pulls/$check_pr/reviews" --paginate 2>/dev/null || printf "[]")
  if printf "%s" "$reviews" | jq -e \
    --arg rid "$run_id" --arg status "$want_status" --arg pstatus "$want_phase" \
    "$_line_marker_jq"'
      (if type == "array" then . else [] end)
      | any((.body // "") as $b |
          ($b | has_run($rid))
          and ($b | has_status($status))
          and (($pstatus == "") or ($b | has_phase($pstatus)))
        )
    ' >/dev/null; then return 0; fi

  inline=$(gh api "repos/$api_repo/pulls/$check_pr/comments" --paginate 2>/dev/null || printf "[]")
  printf "%s" "$inline" | jq -e \
    --arg rid "$run_id" --arg status "$want_status" --arg pstatus "$want_phase" \
    "$_line_marker_jq"'
      (if type == "array" then . else [] end)
      | any((.body // "") as $b |
          ($b | has_run($rid))
          and ($b | has_status($status))
          and (($pstatus == "") or ($b | has_phase($pstatus)))
        )
    ' >/dev/null
}

_pr_marker_sources_json() {
  # Prints a JSON array of {source, createdAt, body} objects from PR body,
  # issue comments, reviews, and inline review comments. Commit messages are
  # intentionally not included because commits are inspection-only for bridge
  # status transitions.
  api_repo="$repo"
  pr_body=$(gh api "repos/$api_repo/pulls/$pr" \
    --jq '{source:"pr_body", createdAt:(.updated_at // .created_at // ""), body:(.body // "")}' \
    2>/dev/null || printf '{"source":"pr_body","createdAt":"","body":""}')
  issue_comments=$(gh api "repos/$api_repo/issues/$pr/comments" --paginate --slurp 2>/dev/null || printf "[]")
  reviews=$(gh api "repos/$api_repo/pulls/$pr/reviews" --paginate --slurp 2>/dev/null || printf "[]")
  inline_comments=$(gh api "repos/$api_repo/pulls/$pr/comments" --paginate --slurp 2>/dev/null || printf "[]")

  jq -n \
    --argjson pr_body "$pr_body" \
    --argjson issue "$issue_comments" \
    --argjson reviews "$reviews" \
    --argjson inline "$inline_comments" '
      def flatten_pages:
        if type == "array" and ((length == 0) or ((.[0] | type) == "array")) then add // []
        elif type == "array" then .
        else []
        end;
      [$pr_body]
      + (($issue // [] | flatten_pages) | map({source:"issue_comment", createdAt:(.created_at // .updated_at // ""), body:(.body // "")}))
      + (($reviews // [] | flatten_pages) | map({source:"review", createdAt:(.submitted_at // .created_at // .updated_at // ""), body:(.body // "")}))
      + (($inline // [] | flatten_pages) | map({source:"inline_comment", createdAt:(.created_at // .updated_at // ""), body:(.body // "")}))
    '
}

_pr_run_ids() {
  _pr_marker_sources_json | jq -r "$_marker_extract_jq"'
    [.[].body | run_ids[]] | unique | .[]
  '
}

_pr_latest_state() {
  # Prints: <status>\t<phase-status>\t<source>\t<createdAt>
  _pr_marker_sources_json | jq -r --arg rid "$run_id" "$_marker_extract_jq"'
    [
      .[]
      | . as $src
      | select(($src.body | run_ids | index($rid)) != null)
      | ($src.body | statuses) as $statuses
      | select(($statuses | length) > 0)
      | {
          source: $src.source,
          createdAt: $src.createdAt,
          status: ($statuses[-1]),
          phase: (($src.body | phase_statuses)[-1] // "")
        }
    ]
    | sort_by(.createdAt)
    | last // empty
    | [.status, .phase, .source, .createdAt]
    | @tsv
  '
}

_pr_latest_marker_after() {
  # _pr_latest_marker_after <status> [phase-status] <createdAt>
  want_status=$1
  want_phase=$2
  after_created=$3
  _pr_marker_sources_json | jq -r \
    --arg rid "$run_id" --arg status "$want_status" --arg pstatus "$want_phase" --arg after "$after_created" \
    "$_line_marker_jq"'
      [
        .[]
        | select((.createdAt // "") > $after)
        | select((.body // "" | has_run($rid)))
        | select((.body // "" | has_status($status)))
        | select(($pstatus == "") or (.body // "" | has_phase($pstatus)))
      ]
      | sort_by(.createdAt)
      | last // empty
      | [.createdAt, .source]
      | @tsv
    '
}

_wait_pr_for_status_after() {
  # _wait_pr_for_status_after <status> [phase-status] <createdAt>
  want_status=$1
  want_phase=$2
  after_created=$3
  start=$(date -u +%s)
  deadline=$((start + timeout))
  while :; do
    now=$(date -u +%s)
    [ "$now" -lt "$deadline" ] || die "timeout waiting for fresh BRIDGE_STATUS: $want_status${want_phase:+ + BRIDGE_PHASE_STATUS: $want_phase}"
    found=$(_pr_latest_marker_after "$want_status" "$want_phase" "$after_created")
    if [ -n "$found" ]; then
      printf "%s\n" "$found"
      return 0
    fi
    sleep "$poll"
  done
}

_wait_review_result_after() {
  # _wait_review_result_after <createdAt> -> prints <result>\t<createdAt>\t<source>
  after_created=$1
  start=$(date -u +%s)
  deadline=$((start + timeout))
  while :; do
    now=$(date -u +%s)
    [ "$now" -lt "$deadline" ] || die "timeout waiting for fresh Codex review result"
    found=$(_pr_latest_marker_after approved completed "$after_created")
    if [ -n "$found" ]; then printf "complete\t%s\n" "$found"; return 0; fi
    found=$(_pr_latest_marker_after approved "" "$after_created")
    if [ -n "$found" ]; then printf "approved\t%s\n" "$found"; return 0; fi
    found=$(_pr_latest_marker_after changes_requested "" "$after_created")
    if [ -n "$found" ]; then printf "changes_requested\t%s\n" "$found"; return 0; fi
    sleep "$poll"
  done
}

_wait_plan_review_result_after() {
  # _wait_plan_review_result_after <createdAt> -> prints <result>\t<createdAt>\t<source>
  # plan_approved here is intermediate; it never carries BRIDGE_PHASE_STATUS: completed
  # and never permits a merge. The bridge waits separately for implementation
  # approval before completion.
  after_created=$1
  start=$(date -u +%s)
  deadline=$((start + timeout))
  while :; do
    now=$(date -u +%s)
    [ "$now" -lt "$deadline" ] || die "timeout waiting for fresh plan review result"
    found=$(_pr_latest_marker_after plan_approved "" "$after_created")
    if [ -n "$found" ]; then printf "plan_approved\t%s\n" "$found"; return 0; fi
    found=$(_pr_latest_marker_after plan_changes_requested "" "$after_created")
    if [ -n "$found" ]; then printf "plan_changes_requested\t%s\n" "$found"; return 0; fi
    sleep "$poll"
  done
}

# _run_plan_review_loop <starting_status> <starting_since>
# Drives Codex plan review and Claude plan-fix until plan_approved.
# Sets globals on success: plan_review_since=<plan_approved createdAt>.
_run_plan_review_loop() {
  local plan_status="$1" plan_since="$2"
  local plan_cycle=1
  local fresh result result_created
  while [ "$plan_cycle" -le "$max_plan_cycles" ]; do
    case "$plan_status" in
      plan_ready)
        log_info "phase: plan-review cycle $plan_cycle/$max_plan_cycles"
        set -- plan-review --repo "$repo" --pr "$pr" --run-id "$run_id" --source-agent "$source_agent"
        [ -n "$reviewer_agent" ] && set -- "$@" --agent "$reviewer_agent"
        [ -n "$plan_file" ] && set -- "$@" --plan-file "$plan_file"
        "$_BRIDGE_BIN_DIR/bridge-phase" "$@"
        fresh=$(_wait_plan_review_result_after "$plan_since")
        result=$(printf "%s\n" "$fresh" | awk -F '\t' '{ print $1 }')
        result_created=$(printf "%s\n" "$fresh" | awk -F '\t' '{ print $2 }')
        plan_since="$result_created"
        case "$result" in
          plan_approved)
            plan_review_since="$plan_since"
            return 0
            ;;
          plan_changes_requested)
            plan_status="plan_changes_requested"
            ;;
        esac
        ;;
      plan_changes_requested)
        [ "$plan_cycle" -lt "$max_plan_cycles" ] || die "max plan-review cycles ($max_plan_cycles) reached with plan_changes_requested — hand-edit the plan file ($(bridge_phase_plan_file)) then re-run with --max-plan-cycles $((max_plan_cycles + 5)) to allow more cycles"
        log_info "phase: plan_changes_requested; nudging plan-fixer"
        set -- plan-fix --repo "$repo" --pr "$pr" --run-id "$run_id" --source-agent "$source_agent"
        [ -n "$fixer_agent" ] && set -- "$@" --agent "$fixer_agent"
        [ -n "$plan_file" ] && set -- "$@" --plan-file "$plan_file"
        "$_BRIDGE_BIN_DIR/bridge-phase" "$@"
        log_info "phase: waiting for fresh plan_ready"
        fresh=$(_wait_pr_for_status_after plan_ready "" "$plan_since")
        plan_since=$(printf "%s\n" "$fresh" | awk -F '\t' '{ print $1 }')
        plan_status="plan_ready"
        plan_cycle=$((plan_cycle + 1))
        ;;
      *)
        die "_run_plan_review_loop: unexpected starting status: $plan_status"
        ;;
    esac
  done
  die "phase exhausted plan-review cycles ($max_plan_cycles) — hand-edit the plan file ($(bridge_phase_plan_file)) and re-run with --max-plan-cycles $((max_plan_cycles + 5))"
}

_warn_dirty_worktree() {
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if [ -n "$(git status --porcelain 2>/dev/null || printf "")" ]; then
      log_warn "local worktree has uncommitted changes; resume will continue using GitHub PR state"
    fi
  fi
}

_post_adoption_comment() {
  adopt_body="BRIDGE_RUN_ID: $run_id
BRIDGE_STATUS: implementation_ready

Bridge phase resume adopted this existing PR.

TASK: $task

The current PR head is treated as implementation_ready so Codex can review it first."
  gh api "repos/$repo/issues/$pr/comments" -f "body=$adopt_body" >/dev/null
}

_print_resume_detected() {
  printf "repo=%s\n" "$repo"
  printf "pr=%s\n" "$pr"
  printf "run_id=%s\n" "$run_id"
  printf "status=%s\n" "$resume_status"
  printf "phase_status=%s\n" "${resume_phase_status:-}"
  printf "source=%s\n" "${resume_source:-}"
  printf "created_at=%s\n" "${resume_created_at:-}"
  printf "next_action=%s\n" "$resume_next_action"
  printf "merge_after_complete=%s\n" "$auto_merge"
}

_nudge_implementer_for_resume() {
  if [ "$dry_run" -eq 1 ]; then return 0; fi
  set -- implement --repo "$repo" --pr "$pr" --run-id "$run_id" --source-agent "$source_agent" --task "$1"
  [ -n "$implementer_agent" ] && set -- "$@" --agent "$implementer_agent"
  "$_BRIDGE_BIN_DIR/bridge-phase" "$@"
}

_nudge_reviewer_for_resume() {
  if [ "$dry_run" -eq 1 ]; then return 0; fi
  set -- review --repo "$repo" --pr "$pr" --run-id "$run_id" --source-agent "$source_agent" --task "$1"
  [ -n "$reviewer_agent" ] && set -- "$@" --agent "$reviewer_agent"
  "$_BRIDGE_BIN_DIR/bridge-phase" "$@"
}

_find_pr_for_status() {
  # _find_pr_for_status <status> [phase-status]
  want_status=$1
  want_phase="${2:-}"
  prs=$(gh pr list --repo "$repo" --state open --limit 100 --json number 2>/dev/null || printf "[]")
  printf "%s" "$prs" | jq -r '.[].number' | while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    if _pr_has_marker "$candidate" "$want_status" "$want_phase"; then
      printf "%s\n" "$candidate"
      exit 0
    fi
  done
}

_wait_pr_for_status() {
  # _wait_pr_for_status <status> [phase-status] -> prints PR number
  want_status=$1
  want_phase="${2:-}"
  start=$(date -u +%s)
  deadline=$((start + timeout))
  while :; do
    now=$(date -u +%s)
    [ "$now" -lt "$deadline" ] || die "timeout waiting for BRIDGE_STATUS: $want_status${want_phase:+ + BRIDGE_PHASE_STATUS: $want_phase}"
    if [ -n "$pr" ]; then
      if _pr_has_marker "$pr" "$want_status" "$want_phase"; then
        printf "%s\n" "$pr"
        return 0
      fi
    else
      found=$(_find_pr_for_status "$want_status" "$want_phase" | head -1)
      if [ -n "$found" ]; then
        printf "%s\n" "$found"
        return 0
      fi
    fi
    sleep "$poll"
  done
}

_wait_review_result() {
  # prints approved, complete, or changes_requested
  start=$(date -u +%s)
  deadline=$((start + timeout))
  while :; do
    now=$(date -u +%s)
    [ "$now" -lt "$deadline" ] || die "timeout waiting for Codex review result"
    if _pr_has_marker "$pr" approved completed; then printf "complete\n"; return 0; fi
    if _pr_has_marker "$pr" approved ""; then printf "approved\n"; return 0; fi
    if _pr_has_marker "$pr" changes_requested ""; then printf "changes_requested\n"; return 0; fi
    sleep "$poll"
  done
}

_ensure_ready_pr() {
  ready_pr=$1
  is_draft=$(gh pr view "$ready_pr" --repo "$repo" --json isDraft --jq '.isDraft' 2>/dev/null || printf "false")
  if [ "$is_draft" = "true" ]; then
    log_info "phase run: marking draft PR #$ready_pr ready for review before merge"
    gh pr ready "$ready_pr" --repo "$repo" >/dev/null
  fi
}

_merge_pr() {
  merge_pr=$1
  _ensure_ready_pr "$merge_pr"
  log_info "phase run: merging PR #$merge_pr with --$merge_method"
  case "$merge_method" in
    merge)  gh pr merge "$merge_pr" --repo "$repo" --merge --delete-branch ;;
    squash) gh pr merge "$merge_pr" --repo "$repo" --squash --delete-branch ;;
    rebase) gh pr merge "$merge_pr" --repo "$repo" --rebase --delete-branch ;;
  esac
}

_run_context_sidecar() {
  # _run_context_sidecar <pr> <after_created>
  # Optional sidecar: nudge context_maintainer, wait for context_updated/context_noop.
  # Never blocks merge on failure.
  [ -n "${BRIDGE_CONTEXT_MAINTAINER:-}" ] || return 0
  local sidecar_pr="$1" sidecar_after="$2" sidecar_timeout="${BRIDGE_CONTEXT_TIMEOUT:-600}"
  log_info "phase run: nudging context_maintainer (sidecar)"
  if ! "$_BRIDGE_BIN_DIR/bridge-phase" context \
       --repo "$repo" --pr "$sidecar_pr" --run-id "$run_id" \
       --source-agent "$source_agent"; then
    log_warn "context_maintainer nudge failed; continuing to merge"
    return 0
  fi
  local start now deadline found
  start=$(date -u +%s)
  deadline=$((start + sidecar_timeout))
  while :; do
    now=$(date -u +%s)
    [ "$now" -lt "$deadline" ] || { log_warn "context_maintainer timed out; continuing to merge"; return 0; }
    found=$(_pr_latest_marker_after context_updated "" "$sidecar_after" 2>/dev/null || true)
    [ -n "$found" ] && { log_ok "context_maintainer: context_updated"; return 0; }
    found=$(_pr_latest_marker_after context_noop "" "$sidecar_after" 2>/dev/null || true)
    [ -n "$found" ] && { log_ok "context_maintainer: context_noop (no docs change needed)"; return 0; }
    sleep "$poll"
  done
}

case "$cmd" in
  resume)
    require_cmd gh
    require_cmd jq
    [ -n "$pr" ] || die "phase resume requires --pr"
    case "$pr" in
      ''|*[!0-9]*) die "PR must be a positive integer (got: $pr)" ;;
    esac
    if [ "$merge_requested" -eq 0 ]; then
      auto_merge=0
    fi
    _warn_dirty_worktree

    if [ -z "$run_id" ]; then
      discovered=$(_pr_run_ids)
      discovered_count=$(printf "%s\n" "$discovered" | awk 'NF { c++ } END { print c + 0 }')
      case "$discovered_count" in
        0)
          [ -n "$task" ] || die "PR #$pr has no BRIDGE_RUN_ID markers; rerun with --task \"...\" to adopt it or pass --run-id"
          run_id=$(bridge_generate_run_id)
          resume_adopting=1
          ;;
        1)
          run_id=$(printf "%s\n" "$discovered" | awk 'NF { print; exit }')
          resume_adopting=0
          ;;
        *)
          die "PR #$pr has multiple BRIDGE_RUN_ID markers; pass --run-id with the exact run to resume"
          ;;
      esac
    else
      resume_adopting=0
    fi

    latest=$(_pr_latest_state)
    if [ -z "$latest" ]; then
      if [ -n "$task" ]; then
        resume_adopting=1
      else
        die "PR #$pr has no BRIDGE_STATUS markers for BRIDGE_RUN_ID: $run_id; pass --task to adopt current PR head"
      fi
    fi

    if [ "${resume_adopting:-0}" -eq 1 ]; then
      resume_status="implementation_ready"
      resume_phase_status=""
      resume_source="adoption"
      resume_created_at="$(bridge_now_iso)"
      resume_next_action="nudge_reviewer"
      if [ "$dry_run" -eq 0 ]; then
        _post_adoption_comment
      fi
    else
      resume_status=$(printf "%s\n" "$latest" | awk -F '\t' '{ print $1 }')
      resume_phase_status=$(printf "%s\n" "$latest" | awk -F '\t' '{ print $2 }')
      resume_source=$(printf "%s\n" "$latest" | awk -F '\t' '{ print $3 }')
      resume_created_at=$(printf "%s\n" "$latest" | awk -F '\t' '{ print $4 }')
      case "$resume_status:$resume_phase_status" in
        plan_ready:*)
          if [ "$review_plan" -eq 1 ]; then
            resume_next_action="run_plan_review"
          else
            resume_next_action="nudge_implementer"
          fi
          ;;
        plan_approved:*)
          resume_next_action="run_context_then_implementer"
          ;;
        plan_changes_requested:*)
          resume_next_action="nudge_plan_fixer"
          ;;
        implementation_ready:*|fixes_pushed:*) resume_next_action="nudge_reviewer" ;;
        changes_requested:*)           resume_next_action="nudge_implementer_for_fixes" ;;
        approved:completed)            resume_next_action="complete" ;;
        approved:*)                    resume_next_action="invalid_approved_missing_completed" ;;
        context_updated:*|context_noop:*)
          if _pr_has_marker "$pr" approved completed; then
            resume_next_action="complete"
          elif _pr_has_marker "$pr" plan_approved ""; then
            resume_next_action="nudge_implementer_skip_context"
          else
            resume_next_action="unknown_status"
          fi
          ;;
        *)                             resume_next_action="unknown_status" ;;
      esac
    fi

    bridge_journal_append "$run_id" "event=resume_detected pr=$pr status=$resume_status next_action=$resume_next_action"
    _print_resume_detected
    if [ "$dry_run" -eq 1 ]; then
      exit 0
    fi

    case "$resume_next_action" in
      invalid_approved_missing_completed)
        die "review approved but BRIDGE_PHASE_STATUS: completed is missing — re-nudge with: bridge phase resume --pr $pr"
        ;;
      unknown_status)
        die "cannot resume from BRIDGE_STATUS: $resume_status — resumable statuses: plan_ready, plan_approved, plan_changes_requested, implementation_ready, fixes_pushed, changes_requested, approved+completed"
        ;;
      complete)
        log_ok "phase resume: completed on PR #$pr run=$run_id"
        bridge_journal_append "$run_id" "event=completed pr=$pr"
        if [ "$auto_merge" -eq 1 ]; then
          bridge_journal_append "$run_id" "event=merging pr=$pr method=$merge_method"
          _merge_pr "$pr"
        fi
        exit 0
        ;;
    esac

    "$_BRIDGE_BIN_DIR/bridge-start"

    current_status="$resume_status"
    current_since="$resume_created_at"

    # Pre-loop staging: plan-review, plan-fix, and context sidecar.
    # After these, the main loop continues from the equivalent of plan_ready
    # (i.e. ready to nudge the implementer).
    case "$resume_next_action" in
      run_plan_review)
        _run_plan_review_loop plan_ready "$current_since"
        current_since="$plan_review_since"
        log_ok "phase resume: plan_approved on PR #$pr"
        _run_context_sidecar "$pr" "$current_since"
        current_status="plan_ready"
        ;;
      nudge_plan_fixer)
        _run_plan_review_loop plan_changes_requested "$current_since"
        current_since="$plan_review_since"
        log_ok "phase resume: plan_approved on PR #$pr"
        _run_context_sidecar "$pr" "$current_since"
        current_status="plan_ready"
        ;;
      run_context_then_implementer)
        _run_context_sidecar "$pr" "$current_since"
        current_status="plan_ready"
        ;;
      nudge_implementer_skip_context)
        current_status="plan_ready"
        ;;
    esac

    cycle=1
    while [ "$cycle" -le "$max_cycles" ]; do
      case "$current_status" in
        plan_ready)
          log_info "phase resume: plan_ready; nudging implementer"
          bridge_journal_append "$run_id" "event=nudge_implementer pr=$pr cycle=$cycle"
          _nudge_implementer_for_resume "Implement the phase in $phase_file, push the branch, and post BRIDGE_STATUS: implementation_ready."
          log_info "phase resume: waiting for implementation_ready"
          fresh=$(_wait_pr_for_status_after implementation_ready "" "$current_since")
          current_since=$(printf "%s\n" "$fresh" | awk -F '\t' '{ print $1 }')
          current_status="implementation_ready"
          bridge_journal_append "$run_id" "event=implementation_ready pr=$pr"
          ;;
        implementation_ready|fixes_pushed)
          log_info "phase resume: review cycle $cycle/$max_cycles"
          bridge_journal_append "$run_id" "event=nudge_reviewer pr=$pr cycle=$cycle"
          _nudge_reviewer_for_resume "Adversarially review the current PR #$pr head for BRIDGE_RUN_ID: $run_id."
          fresh=$(_wait_review_result_after "$current_since")
          result=$(printf "%s\n" "$fresh" | awk -F '\t' '{ print $1 }')
          result_created=$(printf "%s\n" "$fresh" | awk -F '\t' '{ print $2 }')
          bridge_journal_append "$run_id" "event=review_result result=$result pr=$pr cycle=$cycle"
          case "$result" in
            complete)
              log_ok "phase resume: completed on PR #$pr run=$run_id"
              bridge_journal_append "$run_id" "event=completed pr=$pr"
              if [ "$auto_merge" -eq 1 ]; then
                bridge_journal_append "$run_id" "event=merging pr=$pr method=$merge_method"
                _merge_pr "$pr"
              fi
              exit 0
              ;;
            approved)
              die "review approved but BRIDGE_PHASE_STATUS: completed is missing — re-nudge with: bridge phase resume --pr $pr"
              ;;
            changes_requested)
              current_since="$result_created"
              current_status="changes_requested"
              ;;
          esac
          ;;
        changes_requested)
          [ "$cycle" -lt "$max_cycles" ] || die "max review cycles ($max_cycles) reached with changes_requested — pass --max-cycles $((max_cycles + 2)) to allow more fix cycles"
          log_info "phase resume: changes requested; nudging implementer for fixes"
          bridge_journal_append "$run_id" "event=nudge_implementer_fixes pr=$pr cycle=$cycle"
          _nudge_implementer_for_resume "Address Codex review comments on PR #$pr, push fixes, and post BRIDGE_STATUS: fixes_pushed."
          log_info "phase resume: waiting for fixes_pushed"
          fresh=$(_wait_pr_for_status_after fixes_pushed "" "$current_since")
          current_since=$(printf "%s\n" "$fresh" | awk -F '\t' '{ print $1 }')
          current_status="fixes_pushed"
          bridge_journal_append "$run_id" "event=fixes_pushed pr=$pr cycle=$cycle"
          cycle=$((cycle + 1))
          ;;
        approved)
          die "review approved but BRIDGE_PHASE_STATUS: completed is missing — re-nudge with: bridge phase resume --pr $pr"
          ;;
        *)
          die "cannot resume from BRIDGE_STATUS: $current_status — resumable statuses: plan_ready, plan_approved, plan_changes_requested, implementation_ready, fixes_pushed, changes_requested, approved+completed"
          ;;
      esac
    done
    die "phase resume exhausted review cycles ($max_cycles) — pass --max-cycles $((max_cycles + 2)) to allow more fix cycles"
    ;;
  run)
    require_cmd gh
    require_cmd jq
    [ -n "$task" ] || die "phase run requires --task or positional task text"
    "$_BRIDGE_BIN_DIR/bridge-start"

    if [ -z "$run_id" ]; then
      log_info "phase run: nudging orchestrator"
      set -- plan --repo "$repo" --source-agent "$source_agent" --task "$task"
      [ -n "$pr" ] && set -- "$@" --pr "$pr"
      out=$("$_BRIDGE_BIN_DIR/bridge-phase" "$@" 2>&1)
      printf "%s\n" "$out"
      run_id=$(printf "%s\n" "$out" | awk -F= '/^BRIDGE_RUN_ID=/{print $2}' | tail -1)
      [ -n "$run_id" ] || die "could not capture BRIDGE_RUN_ID from plan nudge"
    fi

    mkdir -p .bridge 2>/dev/null || true
    printf "%s\n" "$run_id" > .bridge/last-run 2>/dev/null || true
    bridge_journal_append "$run_id" "event=run_started repo=$repo task=$task"
    log_info "phase run: waiting for plan_ready (run=$run_id)"
    pr=$(_wait_pr_for_status plan_ready)
    log_ok "phase run: plan_ready on PR #$pr"
    bridge_journal_append "$run_id" "event=plan_ready pr=$pr"
    latest=$(_pr_latest_state)
    current_since=$(printf "%s\n" "$latest" | awk -F '\t' '{ print $4 }')

    # Plan-review is a hard gate for fresh runs.
    _run_plan_review_loop plan_ready "$current_since"
    current_since="$plan_review_since"
    log_ok "phase run: plan_approved on PR #$pr"
    bridge_journal_append "$run_id" "event=plan_approved pr=$pr"

    # Context sidecar fires after plan approval and before implementation so
    # docs land before code review. Failures here are non-fatal.
    _run_context_sidecar "$pr" "$current_since"

    log_info "phase run: nudging implementer"
    bridge_journal_append "$run_id" "event=nudge_implementer pr=$pr"
    "$_BRIDGE_BIN_DIR/bridge-phase" implement --repo "$repo" --pr "$pr" --run-id "$run_id" --source-agent "$source_agent"
    log_info "phase run: waiting for implementation_ready"
    fresh=$(_wait_pr_for_status_after implementation_ready "" "$current_since")
    current_since=$(printf "%s\n" "$fresh" | awk -F '\t' '{ print $1 }')
    log_ok "phase run: implementation_ready on PR #$pr"
    bridge_journal_append "$run_id" "event=implementation_ready pr=$pr"

    cycle=1
    while [ "$cycle" -le "$max_cycles" ]; do
      log_info "phase run: review cycle $cycle/$max_cycles"
      bridge_journal_append "$run_id" "event=nudge_reviewer pr=$pr cycle=$cycle"
      "$_BRIDGE_BIN_DIR/bridge-phase" review --repo "$repo" --pr "$pr" --run-id "$run_id" --source-agent "$source_agent"
      fresh=$(_wait_review_result_after "$current_since")
      result=$(printf "%s\n" "$fresh" | awk -F '\t' '{ print $1 }')
      result_created=$(printf "%s\n" "$fresh" | awk -F '\t' '{ print $2 }')
      bridge_journal_append "$run_id" "event=review_result result=$result pr=$pr cycle=$cycle"
      case "$result" in
        complete)
          log_ok "phase run: completed on PR #$pr run=$run_id"
          bridge_journal_append "$run_id" "event=completed pr=$pr"
          if [ "$auto_merge" -eq 1 ]; then
            bridge_journal_append "$run_id" "event=merging pr=$pr method=$merge_method"
            _merge_pr "$pr"
          fi
          exit 0
          ;;
        approved)
          die "review approved but BRIDGE_PHASE_STATUS: completed is missing — re-nudge with: bridge phase resume --pr $pr"
          ;;
        changes_requested)
          [ "$cycle" -lt "$max_cycles" ] || die "max review cycles ($max_cycles) reached with changes_requested — pass --max-cycles $((max_cycles + 2)) to allow more fix cycles"
          current_since="$result_created"
          log_info "phase run: changes requested; nudging implementer for fixes"
          bridge_journal_append "$run_id" "event=nudge_implementer_fixes pr=$pr cycle=$cycle"
          "$_BRIDGE_BIN_DIR/bridge-phase" implement --repo "$repo" --pr "$pr" --run-id "$run_id" --source-agent "$source_agent" --task "Address Codex review comments on PR #$pr, push fixes, and post BRIDGE_STATUS: fixes_pushed."
          log_info "phase run: waiting for fixes_pushed"
          fresh=$(_wait_pr_for_status_after fixes_pushed "" "$current_since")
          current_since=$(printf "%s\n" "$fresh" | awk -F '\t' '{ print $1 }')
          bridge_journal_append "$run_id" "event=fixes_pushed pr=$pr cycle=$cycle"
          ;;
      esac
      cycle=$((cycle + 1))
    done
    die "phase run exhausted review cycles ($max_cycles) — pass --max-cycles $((max_cycles + 2)) to allow more fix cycles"
    ;;
  plan)
    [ -n "$agent" ] || agent="${BRIDGE_ORCHESTRATOR:-claude}"
    [ -n "$task" ] || die "phase plan requires --task or positional task text"
    set -- "$agent" \
      --repo "$repo" \
      --source-agent "$source_agent" \
      --role orchestrator
    [ -n "$pr" ] && set -- "$@" --pr "$pr"
    [ -n "$run_id" ] && set -- "$@" --run-id "$run_id"
    exec "$_BRIDGE_BIN_DIR/bridge-nudge" "$@" \
      --template "$template_dir/orchestrator-prompt.md" \
      --task "$task" \
      --expected-output "A durable phase plan written to $phase_file and a GitHub comment with BRIDGE_STATUS: plan_ready." \
      --status-marker "BRIDGE_STATUS: plan_ready"
    ;;
  plan-review)
    [ -n "$agent" ] || agent="${BRIDGE_REVIEWER:-codex}"
    [ -n "$run_id" ] || die "phase plan-review requires --run-id"
    [ -n "$pr" ] || die "phase plan-review requires --pr"
    effective_plan_file="${plan_file:-$phase_file}"
    [ -n "$task" ] || task="Adversarially review the phase plan in $effective_plan_file for PR #$pr"
    set -- "$agent" \
      --repo "$repo" \
      --pr "$pr" \
      --source-agent "$source_agent" \
      --role plan_reviewer \
      --run-id "$run_id" \
      --template "$template_dir/plan-reviewer-prompt.md" \
      --task "$task" \
      --expected-output "Durable GitHub feedback on the phase plan and exactly one BRIDGE_STATUS: plan_approved or plan_changes_requested marker." \
      --status-marker "BRIDGE_STATUS: plan_approved OR BRIDGE_STATUS: plan_changes_requested"
    [ -n "$plan_file" ] && set -- "$@" --plan-file "$plan_file"
    exec "$_BRIDGE_BIN_DIR/bridge-nudge" "$@"
    ;;
  plan-fix)
    [ -n "$agent" ] || agent="${BRIDGE_ORCHESTRATOR:-claude}"
    [ -n "$run_id" ] || die "phase plan-fix requires --run-id"
    [ -n "$pr" ] || die "phase plan-fix requires --pr"
    effective_plan_file="${plan_file:-$phase_file}"
    [ -n "$task" ] || task="Address Codex plan review on PR #$pr. Revise $effective_plan_file in place to resolve the findings (do not switch files or create a new plan), commit it, and post a fresh GitHub comment with BRIDGE_STATUS: plan_ready."
    set -- "$agent" \
      --repo "$repo" \
      --pr "$pr" \
      --source-agent "$source_agent" \
      --role plan_fixer \
      --run-id "$run_id" \
      --template "$template_dir/orchestrator-prompt.md" \
      --task "$task" \
      --expected-output "An updated $effective_plan_file that resolves the plan review findings and a fresh GitHub comment with BRIDGE_STATUS: plan_ready." \
      --status-marker "BRIDGE_STATUS: plan_ready"
    [ -n "$plan_file" ] && set -- "$@" --plan-file "$plan_file"
    exec "$_BRIDGE_BIN_DIR/bridge-nudge" "$@"
    ;;
  review-plan-file)
    require_cmd gh
    require_cmd jq
    [ -n "$pr" ] || die "phase review-plan-file requires --pr"
    case "$pr" in
      ''|*[!0-9]*) die "PR must be a positive integer (got: $pr)" ;;
    esac
    [ -n "$plan_file" ] || die "phase review-plan-file requires --plan-file"
    [ -f "$plan_file" ] || die "plan file not found: $plan_file"

    # Reviewer agent precedence: --agent (one-shot) > --reviewer > config > default.
    if [ -n "$agent" ]; then reviewer_agent="$agent"; fi
    [ -n "$reviewer_agent" ] || reviewer_agent="${BRIDGE_REVIEWER:-codex}"
    [ -n "$fixer_agent" ]    || fixer_agent="${BRIDGE_ORCHESTRATOR:-claude}"

    # Resolve run-id: explicit, adopted from a single existing marker, or new.
    if [ -z "$run_id" ]; then
      discovered=$(_pr_run_ids)
      discovered_count=$(printf "%s\n" "$discovered" | awk 'NF { c++ } END { print c + 0 }')
      case "$discovered_count" in
        0) run_id=$(bridge_generate_run_id) ;;
        1) run_id=$(printf "%s\n" "$discovered" | awk 'NF { print; exit }') ;;
        *) die "PR #$pr has multiple BRIDGE_RUN_ID markers; pass --run-id with the exact run to use" ;;
      esac
    fi

    log_info "phase review-plan-file: pr=$pr run_id=$run_id plan_file=$plan_file reviewer=$reviewer_agent fixer=$fixer_agent"

    if [ "$dry_run" -eq 1 ]; then
      printf "repo=%s\npr=%s\nrun_id=%s\nplan_file=%s\nreviewer=%s\nfixer=%s\nnext_action=%s\n" \
        "$repo" "$pr" "$run_id" "$plan_file" "$reviewer_agent" "$fixer_agent" "run_plan_review"
      exit 0
    fi

    # Post a durable adoption comment so the plan-review state machine has a
    # fresh BRIDGE_STATUS: plan_ready anchor for THIS run-id and so a follow-up
    # `bridge phase resume` can pick up the resulting markers.
    adopt_iso=$(bridge_now_iso)
    adopt_body="BRIDGE_RUN_ID: $run_id
BRIDGE_STATUS: plan_ready

Bridge phase review-plan-file adopted this PR for plan review.

PHASE_PLAN_FILE: $plan_file"
    gh api "repos/$repo/issues/$pr/comments" -f "body=$adopt_body" >/dev/null
    bridge_journal_append "$run_id" "event=review_plan_file_started pr=$pr plan_file=$plan_file"

    "$_BRIDGE_BIN_DIR/bridge-start"

    _run_plan_review_loop plan_ready "$adopt_iso"
    log_ok "phase review-plan-file: plan_approved on PR #$pr (no implementation triggered)"
    bridge_journal_append "$run_id" "event=plan_approved pr=$pr plan_file=$plan_file"
    exit 0
    ;;
  implement)
    [ -n "$agent" ] || agent="${BRIDGE_IMPLEMENTER:-kiro}"
    [ -n "$run_id" ] || die "phase implement requires --run-id"
    [ -n "$task" ] || task="Implement the phase in $phase_file"
    set -- "$agent" \
      --repo "$repo" \
      --source-agent "$source_agent" \
      --role implementer \
      --run-id "$run_id"
    [ -n "$pr" ] && set -- "$@" --pr "$pr"
    exec "$_BRIDGE_BIN_DIR/bridge-nudge" "$@" \
      --template "$template_dir/implementer-prompt.md" \
      --task "$task" \
      --expected-output "A pushed branch and an open or updated PR with BRIDGE_STATUS: implementation_ready or fixes_pushed." \
      --status-marker "BRIDGE_STATUS: implementation_ready"
    ;;
  review)
    [ -n "$agent" ] || agent="${BRIDGE_REVIEWER:-codex}"
    [ -n "$run_id" ] || die "phase review requires --run-id"
    [ -n "$pr" ] || die "phase review requires --pr"
    [ -n "$task" ] || task="Adversarially review PR #$pr against $phase_file"
    exec "$_BRIDGE_BIN_DIR/bridge-nudge" "$agent" \
      --repo "$repo" \
      --pr "$pr" \
      --source-agent "$source_agent" \
      --role adversarial_reviewer \
      --run-id "$run_id" \
      --template "$template_dir/reviewer-prompt.md" \
      --task "$task" \
      --expected-output "Durable GitHub review comments and BRIDGE_STATUS: approved or changes_requested." \
      --status-marker "BRIDGE_STATUS: approved OR BRIDGE_STATUS: changes_requested"
    ;;
  context)
    [ -n "$agent" ] || agent="${BRIDGE_CONTEXT_MAINTAINER:-}"
    [ -n "$agent" ] || die "phase context requires --agent or orchestration.context_maintainer in config"
    [ -n "$run_id" ] || die "phase context requires --run-id"
    [ -n "$pr" ] || die "phase context requires --pr"
    [ -n "$task" ] || task="Update durable agent docs for PR #$pr against $phase_file"
    exec "$_BRIDGE_BIN_DIR/bridge-nudge" "$agent" \
      --repo "$repo" \
      --pr "$pr" \
      --source-agent "$source_agent" \
      --role context_maintainer \
      --run-id "$run_id" \
      --template "$template_dir/context-maintainer-prompt.md" \
      --task "$task" \
      --expected-output "A PR comment with proposed doc changes as diffs/before-after blocks (no branch commit) plus exactly one BRIDGE_STATUS line." \
      --status-marker "BRIDGE_STATUS: context_updated OR BRIDGE_STATUS: context_noop"
    ;;
  watch)
    [ -n "$pr" ] || die "phase watch requires --pr"
    [ -n "$state" ] || state="complete"
    set -- "$pr"
    [ -n "$repo" ] && set -- "$@" --repo "$repo"
    [ -n "$run_id" ] && set -- "$@" --run-id "$run_id"
    [ -n "$timeout" ] && set -- "$@" --timeout "$timeout"
    [ -n "$poll" ] && set -- "$@" --poll "$poll"
    case "$state" in
      plan)           set -- "$@" --status plan_ready ;;
      implementation) set -- "$@" --status implementation_ready ;;
      approved)       set -- "$@" --status approved ;;
      complete)       set -- "$@" --status approved --phase-status completed ;;
      *) die "unknown watch state: $state" ;;
    esac
    exec "$_BRIDGE_BIN_DIR/bridge-watch" "$@"
    ;;
  plan-edit)
    # Resolve plan file: --plan-file flag > config value > default.
    edit_file="${plan_file:-$phase_file}"
    if [ -n "$pr" ] && [ -z "$plan_file" ]; then
      require_cmd gh
      require_cmd jq
      # Try to read PHASE_PLAN_FILE from the PR's adoption comment.
      all_bodies=$(gh api "repos/$repo/issues/$pr/comments" --paginate \
        --jq '[.[].body // ""] | .[]' 2>/dev/null || true)
      extracted=$(printf "%s\n" "$all_bodies" | awk '
        /^[[:space:]]*PHASE_PLAN_FILE:[[:space:]]+[^[:space:]]/ {
          v = $0
          sub(/^[[:space:]]*PHASE_PLAN_FILE:[[:space:]]+/, "", v)
          sub(/[[:space:]]+$/, "", v)
          print v; exit
        }
      ')
      [ -n "$extracted" ] && edit_file="$extracted"
    fi
    editor="${VISUAL:-${EDITOR:-vi}}"
    log_info "opening plan file: $edit_file (editor: $editor)"
    if [ ! -f "$edit_file" ]; then
      log_warn "plan file does not exist yet; $editor will create it on save"
    fi
    exec "$editor" "$edit_file"
    ;;
esac
