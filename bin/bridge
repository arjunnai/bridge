#!/usr/bin/env bash
# bridge — small dispatcher for bridge-* commands.
set -eu

_BRIDGE_BIN_DIR=$(cd "$(dirname "$0")" && pwd)
if [ -L "$0" ]; then
  _real=$(readlink "$0")
  case "$_real" in
    /*) ;;
    *) _real="$_BRIDGE_BIN_DIR/$_real" ;;
  esac
  _BRIDGE_BIN_DIR=$(cd "$(dirname "$_real")" && pwd)
fi

usage() {
  cat <<EOF
usage: bridge <command> [options]

Commands:
  init     Create config.toml from config.example.toml.
  start    Start tmux sessions for one or all configured agents.
  attach   Attach to an agent's tmux session (or infer from --pr).
  nudge    Send a prompt to an agent session.
  watch    Wait for explicit BRIDGE_STATUS markers on a PR.
  phase    Drive or resume phase plan/implement/review loops.
  doctor   Diagnose local tools, config, repo, and sessions.
  ps       List active bridge runs across open PRs.
  logs     Replay the run journal for a bridge run.

Examples:
  bridge init
  bridge doctor
  bridge start
  bridge attach codex
  bridge attach --pr 42
  bridge phase run --task "Phase 0: inspect live DB prerequisites"
  bridge phase resume --pr 42
  bridge phase plan-edit --pr 42
  bridge nudge claude "Implement X" --dry-run
  bridge watch 42 --status approved
  bridge ps
  bridge ps --watch
  bridge logs --last
  bridge logs --pr 42

Legacy command names still work:
  bridge-start, bridge-nudge, bridge-watch, bridge-doctor
EOF
}

cmd="${1:-}"
case "$cmd" in
  -h|--help|'')
    usage
    exit 0
    ;;
  init|start|attach|nudge|watch|phase|doctor|ps|logs)
    shift
    exec "$_BRIDGE_BIN_DIR/bridge-$cmd" "$@"
    ;;
  *)
    echo "unknown bridge command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
